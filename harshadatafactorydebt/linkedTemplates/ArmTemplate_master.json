{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "harshadatafactorydebt"
		},
		"GitHub1_credential": {
			"type": "secureString",
			"metadata": "Secure string for 'credential' of 'GitHub1'"
		},
		"LS_AzureBlob_Storage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlob_Storage'"
		},
		"LS_PostgreSQL_DE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSQL_DE'"
		},
		"GitHub1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "Harshatatpudisagar"
		},
		"LS_PostgreSQL_DE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "harshapsotgresqldebt.postgres.database.azure.com"
		},
		"LS_PostgreSQL_DE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "de_learning"
		},
		"LS_PostgreSQL_DE_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "pgadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "harshadatafactorydebt_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"GitHub1_credential": {
						"value": "[parameters('GitHub1_credential')]"
					},
					"LS_AzureBlob_Storage_connectionString": {
						"value": "[parameters('LS_AzureBlob_Storage_connectionString')]"
					},
					"LS_PostgreSQL_DE_password": {
						"value": "[parameters('LS_PostgreSQL_DE_password')]"
					},
					"GitHub1_properties_typeProperties_username": {
						"value": "[parameters('GitHub1_properties_typeProperties_username')]"
					},
					"LS_PostgreSQL_DE_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_DE_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_DE_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_DE_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_DE_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_DE_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}