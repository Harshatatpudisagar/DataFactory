{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_REST_Orders",
						"type": "DatasetReference"
					},
					"name": "OrdersAPI"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Staging_Cart_Items",
						"type": "DatasetReference"
					},
					"name": "OrdersAPIsink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     authorization as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     httpMethod: 'GET',",
				"     timeout: 30,",
				"     paginationRules: ['supportRFC5988' -> 'false'],",
				"     responseFormat: ['type' -> 'json', 'documentForm' -> 'documentPerLine']) ~> OrdersAPI",
				"OrdersAPI sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          cart_id as integer,",
				"          product_id as integer,",
				"          product_title as string,",
				"          price as decimal(18,2),",
				"          quantity as integer,",
				"          total as decimal(18,2),",
				"          discount_percentage as decimal(8,2),",
				"          discounted_total as decimal(18,2),",
				"          thumbnail as string,",
				"          source_file as string,",
				"          ingest_timestamp as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> OrdersAPIsink"
			]
		}
	}
}